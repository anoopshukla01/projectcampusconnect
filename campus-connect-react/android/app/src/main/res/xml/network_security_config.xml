<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for Campus Connect APK.
  Permits all HTTPS and HTTP network traffic for mobile app API connectivity.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
